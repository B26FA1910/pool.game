{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare дээрх Worker-ийн нэр (dashboard дээрх нэртэй таарах ёстой)
  "name": "pool-game",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-30",

  // public/ доторх тоглоомыг статик файлаар үйлчилнэ; /ws хүсэлт Worker руу очно
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },

  // Өрөө бүрт нэг Durable Object — онлайн тоглогчдыг холбоно
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
